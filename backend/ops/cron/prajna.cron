# Prajna Stage-1 recurring pipeline (system timezone: IST).
# Install:  crontab ops/cron/prajna.cron      Inspect:  crontab -l
# Logins: one automated Upstox TOTP login per day is permitted by the user
# (2026-09-24, until revoked); --login logs in only if the token is invalid.
# QUOTA IS PER USER: every job sets PRAJNA_UPSTOX_RATE_FRACTION so concurrent jobs sum <= 0.9
# (candles jobs share one flock; fundamentals/corporate-actions run beside them).
SHELL=/bin/bash
B=/home/cis/windows/prajna/backend
LK=/home/cis/windows/prajna/backend/var/run/candles.lock
# 06:30 daily   instrument-master refresh + lifecycle; new listings get 1D history,
#               fundamentals, corporate actions (hardening phase 2)
30 6 * * *    cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.5 flock -w 600 $LK ops/runbooks/daily.sh --login refresh >> var/logs/cron.log 2>&1
# 07:00 Mon-Fri  previous session: 1D (all NSE), FII/DII, news
0 7 * * 1-5   cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.5 flock -w 3600 $LK ops/runbooks/daily.sh --login morning >> var/logs/cron.log 2>&1
# 08:25 Mon-Fri  real pre-open: universe, capture 08:55-09:20, replay, acceptance (skips non-trading days)
25 8 * * 1-5  cd $B && ops/runbooks/preopen_day.sh --login >> var/logs/cron.log 2>&1
# 06:40 daily   maintenance: reap orphaned RUNNING runs, derive price basis / corporate-
#               action factors / global contracts, write the status snapshot
40 6 * * *    cd $B && ops/runbooks/maintenance.sh all >> var/logs/cron.log 2>&1
# 12:40, 21:10 daily  global 1D refresh (13 requests, fraction 0.1, no candles lock): the
#               second fetch re-observes the first -> labels become final (phase 5)
40 12 * * *   cd $B && ops/runbooks/global_refresh.sh >> var/logs/cron.log 2>&1
10 21 * * *   cd $B && ops/runbooks/global_refresh.sh >> var/logs/cron.log 2>&1
# 09:30-15:30 every 30 min Mon-Fri  news poll during market hours (~118 requests / ~1 min,
#               fraction 0.2, own lock; no login): publication->received latency was a median
#               51 h with close/morning polling only (measured 2026-09-25)
30 9 * * 1-5      cd $B && flock -n var/run/news.lock ops/runbooks/news_poll.sh >> var/logs/cron.log 2>&1
0,30 10-15 * * 1-5 cd $B && flock -n var/run/news.lock ops/runbooks/news_poll.sh >> var/logs/cron.log 2>&1
# 16:05 Mon-Fri  today's 1m/15m/1h (complete bars only), news (fraction 0.35), the
#                same-day rerun check (R evidence); hard stop 06:40; NO backfill
5 16 * * 1-5  cd $B && flock -w 3600 $LK ops/runbooks/close_then_backfill.sh --no-backfill >> var/logs/cron.log 2>&1
# 23:55 daily   status snapshot after the close
55 23 * * *   cd $B && ops/runbooks/maintenance.sh status >> var/logs/cron.log 2>&1
# Historical intraday backfill: DEFERRED_FOR_STAGE_1 (capability kept; enable only by
# explicit decision). To enable: drop --no-backfill above, uncomment the two lines below.
# DEFERRED_FOR_STAGE_1: 45 19 * * *   cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.5 flock -n $LK ops/runbooks/backfill.sh --login --until 06:50 >> var/logs/cron.log 2>&1
# DEFERRED_FOR_STAGE_1: 0 9 * * 0,6   cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.5 flock -w 600 $LK ops/runbooks/backfill.sh --login --until 19:30 >> var/logs/cron.log 2>&1
# Saturday 10:00  corporate actions; 1st of month 11:00 calendar +60d and fundamentals
0 10 * * 6    cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.3 ops/runbooks/daily.sh --login weekly >> var/logs/cron.log 2>&1
0 11 1 * *    cd $B && PRAJNA_UPSTOX_RATE_FRACTION=0.3 ops/runbooks/daily.sh --login monthly >> var/logs/cron.log 2>&1
