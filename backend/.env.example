# AutoTrade Pro V2 (prajna) — configuration template.
# Copy to .env and fill in. NOTHING here has a working default: app/core/config.py
# fails fast on a missing required key rather than silently using a placeholder
# DSN (which is how V1 could start up pointed at a database that did not exist).

# ── Database ────────────────────────────────────────────────────────────────
# MUST NOT be autotrade_pro. app/db/engine.py refuses that DSN at import time.
PRAJNA_DATABASE_URL=postgresql+asyncpg://prajna_rw:CHANGEME@localhost:5432/prajna
PRAJNA_TEST_DATABASE_URL=postgresql+asyncpg://prajna_rw:CHANGEME@localhost:5432/prajna_test

# ── Write authorization ─────────────────────────────────────────────────────
# --commit is refused unless this is set and matches. Stage 1 writes are gated
# on possession of a token, not merely on a CLI flag.
PRAJNA_WRITE_TOKEN=

# ── Upstox (the ONLY market-data vendor in V2) ──────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8000/api/v1/upstox/callback
UPSTOX_CLIENT_ID=
UPSTOX_USERNAME=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# ── Paths ───────────────────────────────────────────────────────────────────
PRAJNA_ARCHIVE_DIR=var/archive
PRAJNA_LOG_DIR=var/logs

# ── Runtime ─────────────────────────────────────────────────────────────────
PRAJNA_ENV=dev
PRAJNA_LOG_LEVEL=INFO
# Stage 7 concern. Schema exists; the writer stays off until execution needs it.
PRAJNA_TICK_PERSISTENCE_ENABLED=false
